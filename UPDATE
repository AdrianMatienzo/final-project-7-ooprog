import java.util.List;

/** Part 3: Update User Account. */
public class UpdateUserAccount {

    private final AccountHelper helper;

    public UpdateUserAccount(AccountHelper helper) {
        this.helper = helper;
    }

    public void run() {
        System.out.println("\n--- UPDATE USER ACCOUNT ---");

        if (helper.getAccounts().isEmpty()) {
            System.out.println("No user accounts to update.");
            return;
        }

        String id = helper.prompt("Enter the User ID to update (e.g., U001)",
                s -> AccountHelper.ID_PATTERN.matcher(s.toUpperCase()).matches(),
                "ID must start with 'U' followed by 3-6 digits (e.g., U001).");
        if (id == null) return;

        UserAccount account = helper.findById(id);
        if (account == null) {
            System.out.println("User ID '" + id.toUpperCase() + "' does not exist.");
            return;
        }

        boolean editing = true;
        do {
            System.out.println("\nCurrent account details:");
            helper.printTable(List.of(account));

            System.out.println("What do you want to update?");
            System.out.println("  1. Full Name");
            System.out.println("  2. Username");
            System.out.println("  3. Email");
            System.out.println("  4. Password");
            System.out.println("  5. Role");
            System.out.println("  6. Status");
            System.out.println("  0. Done / Back to main menu");

            String field = helper.prompt("Enter option (0-6)",
                    s -> s.matches("[0-6]"),
                    "Please enter a number from 0 to 6 only.");

            if (field == null || field.equals("0")) {
                editing = false;
            } else {
                switch (field) {
                    case "1": updateFullName(account); break;
                    case "2": updateUsername(account); break;
                    case "3": updateEmail(account);    break;
                    case "4": updatePassword(account); break;
                    case "5": updateRole(account);     break;
                    case "6": updateStatus(account);   break;
                    default: break;
                }
            }
        } while (editing);

        System.out.println("Update session ended.");
    }

    private void updateFullName(UserAccount account) {
        String name = helper.prompt("Enter new Full Name",
                s -> s.length() >= 2 && s.length() <= 50 && AccountHelper.NAME_PATTERN.matcher(s).matches(),
                "Name must be 2-50 characters, letters only (spaces, . ' - allowed between words).");
        if (name == null) return;

        if (name.equals(account.getFullName())) {
            System.out.println("New name is the same as the current name. No changes made.");
            return;
        }
        if (helper.confirm("Change name to '" + name + "'?")) {
            account.setFullName(name);
            System.out.println("Full name updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }

    private void updateUsername(UserAccount account) {
        String uname = helper.prompt("Enter new Username",
                s -> AccountHelper.USERNAME_PATTERN.matcher(s).matches(),
                "Username must be 4-20 chars, start with a letter, and use only letters, numbers, or underscore.");
        if (uname == null) return;

        if (uname.equalsIgnoreCase(account.getUsername())) {
            System.out.println("New username is the same as the current one. No changes made.");
            return;
        }
        if (helper.findByUsername(uname) != null) {
            System.out.println("Username '" + uname + "' is already taken.");
            return;
        }
        if (helper.confirm("Change username to '" + uname + "'?")) {
            account.setUsername(uname);
            System.out.println("Username updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }

    private void updateEmail(UserAccount account) {
        String mail = helper.prompt("Enter new Email",
                s -> s.length() <= 100 && AccountHelper.EMAIL_PATTERN.matcher(s).matches(),
                "Invalid email format (example: name@domain.com, max 100 chars).");
        if (mail == null) return;

        if (mail.equalsIgnoreCase(account.getEmail())) {
            System.out.println("New email is the same as the current one. No changes made.");
            return;
        }
        if (helper.findByEmail(mail) != null) {
            System.out.println("Email '" + mail + "' is already used by another account.");
            return;
        }
        if (helper.confirm("Change email to '" + mail + "'?")) {
            account.setEmail(mail);
            System.out.println("Email updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }

    private void updatePassword(UserAccount account) {
        String pass = helper.prompt("Enter new Password",
                AccountHelper::isStrongPassword,
                "Password must be 8-32 chars with uppercase, lowercase, number, special character (!@#$%^&*), and no spaces.");
        if (pass == null) return;

        if (AccountHelper.hash(pass).equals(account.getPasswordHash())) {
            System.out.println("New password must be different from the current password.");
            return;
        }
        String again = helper.prompt("Confirm new Password",
                s -> s.equals(pass),
                "Passwords do not match.");
        if (again == null) return;

        if (helper.confirm("Change password?")) {
            account.setPasswordHash(AccountHelper.hash(pass));
            System.out.println("Password updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }

    private void updateRole(UserAccount account) {
        String role = helper.prompt("Enter new Role " + String.join("/", AccountHelper.ROLES),
                s -> AccountHelper.isInList(s, AccountHelper.ROLES),
                "Role must be one of: " + String.join(", ", AccountHelper.ROLES) + ".");
        if (role == null) return;
        role = role.toUpperCase();

        if (role.equals(account.getRole())) {
            System.out.println("Account already has that role. No changes made.");
            return;
        }
        if (account.getRole().equals("ADMIN") && account.getStatus().equals("ACTIVE")
                && helper.countActiveAdmins() <= 1) {
            System.out.println("Cannot change role: this is the last ACTIVE admin account.");
            return;
        }
        if (helper.confirm("Change role to '" + role + "'?")) {
            account.setRole(role);
            System.out.println("Role updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }

    private void updateStatus(UserAccount account) {
        String status = helper.prompt("Enter new Status " + String.join("/", AccountHelper.STATUSES),
                s -> AccountHelper.isInList(s, AccountHelper.STATUSES),
                "Status must be one of: " + String.join(", ", AccountHelper.STATUSES) + ".");
        if (status == null) return;
        status = status.toUpperCase();

        if (status.equals(account.getStatus())) {
            System.out.println("Account already has that status. No changes made.");
            return;
        }
        if (account.getRole().equals("ADMIN") && account.getStatus().equals("ACTIVE")
                && !status.equals("ACTIVE") && helper.countActiveAdmins() <= 1) {
            System.out.println("Cannot deactivate/suspend: this is the last ACTIVE admin account.");
            return;
        }
        if (helper.confirm("Change status to '" + status + "'?")) {
            account.setStatus(status);
            System.out.println("Status updated successfully.");
        } else {
            System.out.println("Update cancelled.");
        }
    }
}
