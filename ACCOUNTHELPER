import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.List;
import java.util.Scanner;
import java.util.function.Predicate;
import java.util.regex.Pattern;

public class AccountHelper {

    public static final int MAX_ATTEMPTS = 3;
    public static final String[] ROLES    = {"STUDENT", "TEACHER", "ADMIN"};
    public static final String[] STATUSES = {"ACTIVE", "INACTIVE", "SUSPENDED"};

    public static final Pattern ID_PATTERN       = Pattern.compile("^U\\d{3,6}$");
    public static final Pattern USERNAME_PATTERN = Pattern.compile("^[A-Za-z][A-Za-z0-9_]{3,19}$");
    public static final Pattern NAME_PATTERN     = Pattern.compile("^[A-Za-z]+([ .'-][A-Za-z]+)*$");
    public static final Pattern EMAIL_PATTERN    = Pattern.compile("^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$");

    private final List<UserAccount> accounts;
    private final Scanner scanner;

    public AccountHelper(List<UserAccount> accounts, Scanner scanner) {
        this.accounts = accounts;
        this.scanner = scanner;
    }

    public List<UserAccount> getAccounts() {
        return accounts;
    }

    // ===================== INPUT =====================

    /** Bounded for-loop instead of while(true). Returns null on cancel, too many attempts, or closed input. */
    public String prompt(String label, Predicate<String> validator, String errorMessage) {
        for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
            System.out.print(label + ": ");

            if (!scanner.hasNextLine()) {
                System.out.println("\nInput closed.");
                return null;
            }
            String input = scanner.nextLine().trim();

            if (input.equalsIgnoreCase("cancel")) {
                System.out.println("Cancelled.");
                return null;
            }
            if (input.isEmpty()) {
                System.out.println("  [Invalid] Input cannot be empty. (Attempt " + attempt + "/" + MAX_ATTEMPTS + ")");
                continue;
            }
            if (validator.test(input)) {
                return input;
            }
            System.out.println("  [Invalid] " + errorMessage + " (Attempt " + attempt + "/" + MAX_ATTEMPTS + ")");
        }
        System.out.println("Too many invalid attempts. Returning to previous menu.");
        return null;
    }

    public boolean confirm(String question) {
        String answer = prompt(question + " (Y/N)",
                s -> s.equalsIgnoreCase("Y") || s.equalsIgnoreCase("N"),
                "Please enter Y or N only.");
        return answer != null && answer.equalsIgnoreCase("Y");
    }

    // ===================== VALIDATION =====================
    public static boolean isInList(String value, String[] options) {
        for (String option : options) {
            if (option.equalsIgnoreCase(value)) return true;
        }
        return false;
    }

    public static boolean isStrongPassword(String p) {
        if (p.length() < 8 || p.length() > 32) return false;
        boolean upper = false, lower = false, digit = false, special = false;
        for (char c : p.toCharArray()) {
            if (Character.isUpperCase(c))        upper = true;
            else if (Character.isLowerCase(c))   lower = true;
            else if (Character.isDigit(c))       digit = true;
            else if ("!@#$%^&*".indexOf(c) >= 0) special = true;
            else return false; // spaces and other characters are not allowed
        }
        return upper && lower && digit && special;
    }

    // ===================== LOOKUPS =====================
    public UserAccount findById(String id) {
        for (UserAccount a : accounts) {
            if (a.getId().equalsIgnoreCase(id)) return a;
        }
        return null;
    }

    public UserAccount findByUsername(String username) {
        for (UserAccount a : accounts) {
            if (a.getUsername().equalsIgnoreCase(username)) return a;
        }
        return null;
    }

    public UserAccount findByEmail(String email) {
        for (UserAccount a : accounts) {
            if (a.getEmail().equalsIgnoreCase(email)) return a;
        }
        return null;
    }

    public int countActiveAdmins() {
        int count = 0;
        for (UserAccount a : accounts) {
            if (a.getRole().equals("ADMIN") && a.getStatus().equals("ACTIVE")) count++;
        }
        return count;
    }

    // ===================== DISPLAY / SECURITY =====================
    public void printTable(List<UserAccount> list) {
        String line = "+--------+----------------------+------------------+--------------------------------+----------+-----------+";
        System.out.println(line);
        System.out.printf("| %-6s | %-20s | %-16s | %-30s | %-8s | %-9s |%n",
                "ID", "Full Name", "Username", "Email", "Role", "Status");
        System.out.println(line);
        for (UserAccount a : list) {
            System.out.printf("| %-6s | %-20s | %-16s | %-30s | %-8s | %-9s |%n",
                    a.getId(), cut(a.getFullName(), 20), cut(a.getUsername(), 16),
                    cut(a.getEmail(), 30), a.getRole(), a.getStatus());
        }
        System.out.println(line);
    }

    private static String cut(String text, int max) {
        return text.length() <= max ? text : text.substring(0, max - 3) + "...";
    }

    public static String hash(String password) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] bytes = md.digest(password.getBytes(StandardCharsets.UTF_8));
            StringBuilder sb = new StringBuilder();
            for (byte b : bytes) sb.append(String.format("%02x", b));
            return sb.toString();
        } catch (Exception e) {
            throw new IllegalStateException("Hashing failed", e);
        }
    }
}
