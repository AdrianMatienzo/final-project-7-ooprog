import java.util.List;
import java.util.Scanner;

public class StudentMenu {
    private final StudentRepository repository;
    private final Scanner scanner = new Scanner(System.in);

    public StudentMenu(StudentRepository repository) {
        this.repository = repository;
    }

    public void run() {
        int choice;
        do {
            printMenu();
            choice = readInt("Choose an option: ", 0, 3);
            handle(choice);
        } while (choice != 0);
    }

    private void printMenu() {
        System.out.println("\n=== Student Management System ===");
        System.out.println("1. Add Student Record");
        System.out.println("2. View All Student Records");
        System.out.println("3. Search Student Record");
        System.out.println("0. Exit");
    }

    private void handle(int choice) {
        switch (choice) {
            case 1 -> addStudent();
            case 2 -> viewAllStudents();
            case 3 -> searchStudent();
            default -> System.out.println("Goodbye!");
        }
    }

    private void addStudent() {
        String id = readText("Student ID: ");
        if (repository.exists(id)) {
            System.out.println("A student with that ID already exists.");
            return;
        }
        String name = readText("Name: ");
        String course = readText("Course: ");
        int yearLevel = readInt("Year Level (1-5): ", 1, 5);
        repository.add(new Student(id, name, course, yearLevel));
        System.out.println("Student record added.");
    }

    private void viewAllStudents() {
        display(repository.findAll());
    }

    private void searchStudent() {
        String keyword = readText("Enter student ID or name: ");
        display(repository.search(keyword));
    }

    private void display(List<Student> students) {
        if (students.isEmpty()) {
            System.out.println("No student records found.");
            return;
        }
        System.out.println();
        students.forEach(System.out::println);
    }

    private String readText(String prompt) {
        String input;
        do {
            System.out.print(prompt);
            input = scanner.nextLine().trim();
        } while (input.isEmpty());
        return input;
    }

    private int readInt(String prompt, int min, int max) {
        while (true) {
            try {
                System.out.print(prompt);
                int value = Integer.parseInt(scanner.nextLine().trim());
                if (value >= min && value <= max) {
                    return value;
                }
            } catch (NumberFormatException ignored) {
            }
            System.out.printf("Enter a number from %d to %d.%n", min, max);
        }
    }
}
