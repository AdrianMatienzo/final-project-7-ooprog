public class Student {
    private final String id;
    private final String name;
    private final String course;
    private final int yearLevel;

    public Student(String id, String name, String course, int yearLevel) {
        this.id = id;
        this.name = name;
        this.course = course;
        this.yearLevel = yearLevel;
    }

    public String getId() {
        return id;
    }

    public boolean matches(String keyword) {
        String key = keyword.toLowerCase();
        return id.toLowerCase().contains(key) || name.toLowerCase().contains(key);
    }

    @Override
    public String toString() {
        return String.format("%-12s %-25s %-10s Year %d", id, name, course, yearLevel);
    }
}
